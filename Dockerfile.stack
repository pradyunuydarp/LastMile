# The whole LastMile backend in ONE image, for render.free.yaml (a single
# free Render web service). cmd/stack starts the eight services and the
# gateway as separate processes talking gRPC over localhost.
#
#   docker build -f Dockerfile.stack -t lastmile-stack .
#   docker run --rm -e PORT=8082 -p 8082:8082 lastmile-stack
#
# For the real microservices deployment (one container per service) use the
# root Dockerfile with --build-arg SERVICE=<name>, as render.yaml does.

# ---- build ----------------------------------------------------------------
FROM golang:1.25-alpine AS builder
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal
COPY gen ./gen

# One `go build` for every binary: they share the compile cache.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/ \
      ./cmd/station ./cmd/driver ./cmd/user ./cmd/matching ./cmd/location \
      ./cmd/rider ./cmd/trip ./cmd/notification ./cmd/gateway ./cmd/stack

# ---- run ------------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/ /app/
USER nonroot:nonroot
ENTRYPOINT ["/app/stack"]
